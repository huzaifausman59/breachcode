# Copy to .env and fill in values before running.
# NEVER commit .env to version control.

# ----- Server -----
PORT=3000
NODE_ENV=development

# ----- Session -----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_BEFORE_RUNNING

# ----- Database -----
DB_PATH=./data/breachcoach.db

# ----- Mail (MailHog — local only) -----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@northwind-university.local

# ----- App -----
APP_BASE_URL=http://localhost:3000
ORG_NAME=Northwind University

# ----- Rate limiting -----
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=30
API_RATE_LIMIT=100
API_RATE_WINDOW_MINUTES=15

# ----- Upload -----
MAX_UPLOAD_BYTES=5242880

# ----- Session expiry -----
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
