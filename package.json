{
  "name": "breachcoach",
  "version": "1.0.0",
  "description": "Ethical anti-phishing training platform — Northwind University, Group 15",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "setup": "node src/repo/migrate.js",
    "seed":  "node src/repo/seed.js",
    "start": "node src/server.js",
    "dev":   "node --watch src/server.js",
    "test":           "node --test tests/unit/**/*.test.js tests/api/**/*.test.js",
    "test:security":  "node --test tests/security/**/*.test.js",
    "test:e2e":       "node --test tests/e2e/**/*.test.js",
    "test:all":       "node --test tests/**/**/*.test.js",
    "report":         "node src/security/engine/evaluate.js"
  },
  "dependencies": {
    "dotenv":             "^16.4.5",
    "better-sqlite3":     "^9.4.3",
    "argon2":             "^0.31.2",
    "express":            "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-session":    "^1.18.0",
    "connect-sqlite3":    "^0.9.14",
    "helmet":             "^7.1.0",
    "multer":             "^1.4.5-lts.1",
    "nodemailer":         "^6.9.12",
    "csv-parse":          "^5.5.5",
    "zod":                "^3.22.4",
    "pino":               "^8.19.0",
    "pino-pretty":        "^11.0.0",
    "cookie-parser":      "^1.4.6",
    "uuid":               "^9.0.1"
  },
  "devDependencies": {
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}